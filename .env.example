# 本地开发：复制为 .dev.vars（已被 Git 忽略），保存后重启 npm run dev。
# 线上部署：在部署平台的环境变量 / Secret 中配置同名变量。
# 密钥只放在服务端环境变量里，不要写进源码、前端变量、截图或公开仓库。

# ---------- 方案一（推荐）：OpenAI 兼容接口，默认智谱开放平台 ----------
# 智谱 GLM 免费模型：glm-4.7-flash（文本，支持工具调用、流式输出、JSON 输出）
#                    glm-4.6v-flash（视觉，用于图片文字识别）
LLM_API_KEY=
LLM_MODEL=glm-4.7-flash
# 可选：留空即 https://open.bigmodel.cn/api/paas/v4
LLM_BASE_URL=
# 可选：图片文字识别使用的视觉模型；留空则不提供图片识别
LLM_VISION_MODEL=glm-4.6v-flash
# 可选：语义向量检索（BM25 与向量 RRF 融合），会产生额外费用，例如智谱 embedding-3
LLM_EMBEDDING_MODEL=
# 可选：enabled / disabled，控制支持深度思考的模型是否输出推理过程；留空时问答使用模型默认值，出题与复述评估不思考
LLM_THINKING=

# 其他 OpenAI 兼容服务：替换 LLM_BASE_URL 与 LLM_MODEL（模型 ID 以服务商控制台为准）
#   DeepSeek      https://api.deepseek.com                            deepseek-flash（已实测；同一模型支持视觉，
#                 LLM_VISION_MODEL 也填 deepseek-flash；默认开启思考，LLM_THINKING=disabled 可关闭以提速）
#   通义千问      https://dashscope.aliyuncs.com/compatible-mode/v1   qwen-plus
#   Kimi          https://api.moonshot.cn/v1
#   硅基流动      https://api.siliconflow.cn/v1
#   本地 Ollama   http://127.0.0.1:11434/v1                           本地服务无需 LLM_API_KEY

# ---------- 方案二：Google Gemini ----------
# 只填写 GEMINI_API_KEY（不填 LLM_API_KEY）即使用 Gemini；也可显式设置 LLM_PROVIDER=gemini
# LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=
# 可选，例如 gemini-embedding-001
GEMINI_EMBEDDING_MODEL=
