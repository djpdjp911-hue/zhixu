# Local development: copy to .dev.vars (ignored by Git).
# Hosted deployment: configure secrets with Sites environment settings.
# Do not paste API keys into source code or client-side variables.
GEMINI_API_KEY=
# Choose a model available to your API project. Official example at implementation time:
GEMINI_MODEL=gemini-3.8-flash
# Optional. Empty means lexical retrieval only. Extra API usage applies.
GEMINI_EMBEDDING_MODEL=
# Example: gemini-embedding-001
